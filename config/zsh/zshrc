# ==========================================================================
# zsh configuration — arronflow
# ==========================================================================
# Canonical copy: config/zsh/zshrc, deployed to ~/.zshrc (symlink).
# Reload cleanly with: exec zsh
# Walkthrough: docs/shell.md
#
# Portability rule: this file contains ONLY workflow configuration.
# Machine-specific setup (conda, nvm, sdkman, JAVA_HOME, private PATHs)
# belongs in ~/.zshrc.local, which is loaded at the bottom and never
# enters this repository.

# --- Greeting ---------------------------------------------------------------
# fastfetch: the fast Rust successor to neofetch. Guarded so a fresh clone
# before `brew bundle` does not error on every shell start.
command -v fastfetch >/dev/null 2>&1 && fastfetch

# --- Powerlevel10k instant prompt -------------------------------------------
# Shows the cached last prompt immediately while the rest of this file (and
# ~/.zshrc.local) loads. Must come AFTER the greeting (which prints to the
# console) and BEFORE Oh My Zsh — same order as the pre-arronflow zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- Oh My Zsh --------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

# Prompt: Powerlevel10k — the user's own wizard config, deployed to
# ~/.p10k.zsh (symlink from config/zsh/p10k.zsh). The config file itself is
# sourced further down, after oh-my-zsh.sh. Re-run the wizard any time
# with `p10k configure`.
ZSH_THEME="powerlevel10k/powerlevel10k"

# Every plugin costs startup time; each one here earns its keep:
#   git                    ~100 git aliases (gst, gco, gp, glog, ...)
#   aliases                `als`: list every active alias grouped by source
#   extract                `extract <archive>`: one command, every format
#   zsh-autosuggestions    ghost-text history suggestions  (external → custom/)
#   zsh-syntax-highlighting live command coloring; must load LAST (external → custom/)
plugins=(git aliases extract zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# Load the Powerlevel10k config (~/.p10k.zsh symlinks to this repo). REQUIRED:
# the OMz theme alone does not read this file — without this line every fresh
# shell falls back to built-in defaults and auto-runs `p10k configure`.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# --- Options ----------------------------------------------------------------
# Offer to fix command typos ("zsh: correct 'gti' to 'git'?[nyae]").
setopt CORRECT

# --- PATH (portable additions only) -----------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# --- Modern CLI replacements -------------------------------------------------
# Only tools whose output is "for humans" take the classic names. Tools that
# scripts and tutorials reference by name (grep, find) keep their originals —
# use the modern ones by typing their real names (rg, fd).
alias ls='eza -lh --group-directories-first --icons'
alias ll='eza -lha --group-directories-first --icons'
alias cat='bat --paging=never'

# --- Autosuggestions partial accept -----------------------------------------
# → (Right) accepts the whole ghost suggestion; Ctrl+→ accepts one word.
bindkey '^[[1;5C' forward-word

# --- Tool initialization ------------------------------------------------------
eval "$(zoxide init zsh)"   # z <dir>: frecency jump; zi: interactive picker
eval "$(fzf --zsh)"         # Ctrl+R: fuzzy history; Ctrl+T: file; Alt+C: dirs

# --- Machine-specific overrides (NOT in this repo) ---------------------------
# Put conda/nvm/sdkman/JAVA_HOME/private PATHs in ~/.zshrc.local.
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
