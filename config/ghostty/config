# ==========================================================================
# Ghostty configuration
# ==========================================================================
# Canonical copy: arronflow repo, config/ghostty/config
# Deployed to ~/.config/ghostty/config by scripts/install.sh (symlink).
# Reload at runtime: Cmd+Shift+,
# Full option reference: ghostty +show-config --default --docs
# Walkthrough: docs/ghostty.md

# --------------------------------------------------------------------------
# Typography
# --------------------------------------------------------------------------
# Maple Mono NF CN = Maple Mono + Nerd Font icons (NF) + CJK glyphs (CN).
# The Nerd Font icons power yazi, prompts, and statuslines; the CJK glyphs
# keep Chinese text aligned on the terminal grid.
font-family = Maple Mono NF CN
font-size = 14
# font-thicken compensates for thin macOS text rendering at small sizes.
font-thicken = true
# A little extra vertical breathing room per cell (default feels cramped).
adjust-cell-height = 2

# --------------------------------------------------------------------------
# Theme
# --------------------------------------------------------------------------
# Atom One Dark: dark background, gentle contrast, easy on the eyes.
# Preview alternatives live: ghostty +list-themes
theme = Atom One Dark

# --------------------------------------------------------------------------
# Window appearance
# --------------------------------------------------------------------------
# Subtle see-through: 90% opacity over a 30px blur. Raise opacity toward 1.0
# for more readability, lower it for more desktop showing through. The blur
# keeps text legible even over a busy wallpaper.
background-opacity = 0.75
background-blur-radius = 30
# Borderless look: the title bar blends into the terminal background.
macos-titlebar-style = transparent
# Inner margins around the text area, in pixels.
window-padding-x = 10
window-padding-y = 8
# Reopen windows with the same tabs/splits after quitting.
window-save-state = always
# Window chrome follows the system light/dark appearance.
window-theme = auto
# Native macOS fullscreen moves the window to its own Space over an opaque
# system backdrop, which silently kills background-opacity/blur. Non-native
# fullscreen is a regular window maximized to the screen, so transparency
# keeps working; "visible-menu" keeps the menu bar on screen.
# Toggle fullscreen with Ctrl+Cmd+F. Values: true | visible-menu |
# padded-notch (clears the notch) | false (back to native fullscreen).
macos-non-native-fullscreen = visible-menu

# Decide in the tmux step: makes Option work as Alt/Meta for tmux bindings.
# macos-option-as-alt = true

# --------------------------------------------------------------------------
# Cursor
# --------------------------------------------------------------------------
# Block cursor for everything outside editors; Neovim overrides the shape
# itself when switching insert/normal mode.
cursor-style = block
cursor-style-blink = true
# Atom One Dark blue — matches the palette instead of fighting it.
cursor-color = #61afef
cursor-opacity = 0.9

# --------------------------------------------------------------------------
# Mouse & clipboard
# --------------------------------------------------------------------------
mouse-hide-while-typing = true
# Selection goes straight to the system clipboard (no Cmd+C needed).
copy-on-select = clipboard
# Ask before pasting multi-line text — protects against accidentally pasting
# dangerous content copied from web pages into the shell.
clipboard-paste-protection = true

# --------------------------------------------------------------------------
# Quick terminal (Quake-style dropdown)
# --------------------------------------------------------------------------
# Ctrl+` summons a dropdown terminal from the top edge, from anywhere in
# macOS; it hides itself as soon as it loses focus.
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --------------------------------------------------------------------------
# Shell integration
# --------------------------------------------------------------------------
# Injects a small script into the shell at startup so Ghostty knows where
# the prompts are (Cmd+Up/Down jumps between them) and what the cwd is.
shell-integration = detect
# no-cursor: editors like Neovim manage the cursor shape themselves, so the
# shell integration should not also try to set it.
shell-integration-features = no-cursor

# --------------------------------------------------------------------------
# Keybindings
# --------------------------------------------------------------------------
# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Reload this file without restarting Ghostty
keybind = cmd+shift+comma=reload_config

# --------------------------------------------------------------------------
# Performance
# --------------------------------------------------------------------------
# 25 MB of scrollback — enough to scroll back through full build/test logs.
scrollback-limit = 25000000
